# EnvironmentFile for company-agent-oidc-sync.service.
# systemd does NOT expand %h here, so use real absolute paths. Either run
#   scripts/install_oidc_timer.sh
# to generate this file for $HOME, or edit the three paths below before enabling the timer.
POC_ROOT=/absolute/path/to/company-ai-network
POC_RUNTIME=/absolute/path/to/company-ai-network/.runtime-lan
POC_OIDC_TOKEN_DIR=/absolute/path/to/.config/company-agent/oidc-tokens
